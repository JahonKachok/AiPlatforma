# Django — SECRET_KEY ni albatta almashtiring (prod bu qiymat bilan ishga tushmaydi):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changeme-generate-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Tashkent

# Database (defaults to sqlite if unset)
# DATABASE_URL=postgres://aiplatforma:aiplatforma123@localhost:5432/aiplatforma
# DATABASE_URL=sqlite:///db.sqlite3

# --- Docker/server rejimi uchun (docker compose up) — RUNNING.md, A bo'lim ---
# Konteynerlarda host nomlari xizmat nomlariga teng: db, redis
# DEBUG=False
# DOMAIN=example.uz                      # nginx va HTTPS sertifikati uchun
# LETSENCRYPT_EMAIL=admin@example.uz     # sertifikat muddati haqida xabarlar
# LETSENCRYPT_WWW=1                      # www.example.uz uchun DNS yo'q bo'lsa 0
# ALLOWED_HOSTS=example.uz,www.example.uz
# CSRF_TRUSTED_ORIGINS=https://example.uz
# FRONTEND_URL=https://example.uz
# SECURE_SSL_REDIRECT=True
# DATABASE_URL=postgres://aiplatforma:POSTGRES_PASSWORD_BILAN_BIR_XIL@db:5432/aiplatforma
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
# POSTGRES_DB=aiplatforma
# POSTGRES_USER=aiplatforma
# POSTGRES_PASSWORD=kuchli-parol-qoying  # python -c "import secrets; print(secrets.token_urlsafe(32))"
# BACKUP_KEEP_DAYS=14                    # baza nusxalari necha kun saqlanadi
# SESSION_COOKIE_AGE=43200               # sessiya muddati, soniya (12 soat)

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Cache (prod): login urinishlarini cheklash hisoblagichi shu yerda saqlanadi.
# CACHE_URL=redis://redis:6379/1

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Email (SMTP) — leave blank to use the console backend in dev
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@buildflow.local

FRONTEND_URL=http://localhost:8000

# AI agents — one key is enough. Gemini is used when GEMINI_API_KEY is set,
# otherwise Claude via ANTHROPIC_API_KEY. Force with AI_PROVIDER=gemini|anthropic.
# Free Gemini key: https://aistudio.google.com | Claude: https://console.anthropic.com
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# AI_PROVIDER=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# AI_MODEL=claude-opus-4-8
