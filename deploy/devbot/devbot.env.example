# /etc/aiplatforma-devbot.env  (chmod 600)
#
# Bot tokeni, username, Claude kaliti va modeli bu yerda EMAS — platformada:
# Profil → Integratsiyalar → Devbot. Buyruqni Telegram'i ulangan adminlar beradi.

# Ishlab turgan platforma papkasi (git clone + .env + docker-compose.yml).
DEVBOT_PROD_DIR=/opt/AiPlatforma

# Ixtiyoriy sozlamalar:
# DEVBOT_STATE_DIR=/home/deploy/.aiplatforma-devbot   # ishchi klon, Claude sessiyalari, holat
# DEVBOT_MAIN_BRANCH=main
# DEVBOT_WEB_CONTAINER=aiplatforma_web
# DEVBOT_RUNNER_MEMORY=1g                  # Claude konteyneri uchun RAM chegarasi
# DEVBOT_RUNNER_CPUS=1.5
# DEVBOT_MAX_TURNS=120
# DEVBOT_CLAUDE_TIMEOUT=2700               # bitta vazifa uchun, soniya
# DEVBOT_RUN_TESTS=1
# DEVBOT_HEALTH_TIMEOUT=300
# Deploydan keyin main'ni GitHub'ga push qilish (serverda yozish huquqli
# deploy key kerak). Aks holda o'zgarishlar faqat serverda qoladi.
# DEVBOT_PUSH_TO_ORIGIN=0
# Favqulodda zaxira (panel ishlamay qolsa):
# DEVBOT_TELEGRAM_TOKEN=
# ANTHROPIC_API_KEY=
# DEVBOT_ALLOWED_USER_IDS=
