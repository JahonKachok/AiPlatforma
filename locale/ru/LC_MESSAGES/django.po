msgstr "Сырдарьинская область"

msgid "Jizzakh region"
msgstr "Джизакская область"

msgid "Samarkand region"
msgstr "Самаркандская область"

msgid "Bukhara region"
msgstr "Бухарская область"

msgid "Navoi region"
msgstr "Навоийская область"

msgid "Kashkadarya region"
msgstr "Кашкадарьинская область"

msgid "Surkhandarya region"
msgstr "Сурхандарьинская область"

msgid "Khorezm region"
msgstr "Хорезмская область"

msgid "Republic of Karakalpakstan"
msgstr "Республика Каракалпакстан"

