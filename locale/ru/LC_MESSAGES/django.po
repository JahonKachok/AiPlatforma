msgstr "Новое направление"

msgid "No disciplines yet."
msgstr "Пока нет направлений."

msgid "Delete this discipline?"
msgstr "Удалить это направление?"

msgid "Discipline created."
msgstr "Направление создано."

msgid "Discipline deleted."
msgstr "Направление удалено."

msgid ""
"This discipline is used by one or more sub-objects and cannot be deleted."
msgstr ""
"Это направление используется в одном или нескольких подобъектах и не может "
"быть удалено."

msgid "A short unique code, e.g. AR, KR."
msgstr "Короткий уникальный код, например: AR, KR."

msgid "The discipline's full name."
msgstr "Полное название направления."

msgid "Employees in this discipline:"
msgstr "Сотрудники по этому направлению:"

