# nginx konteyneri ishga tushganda ${DOMAIN} .env dagi qiymat bilan
# almashtiriladi (rasmiy image'ning envsubst bosqichi; faqat muhitda
# belgilangan o'zgaruvchilar almashtiriladi, $host kabilar tegilmaydi).
# Natija: /etc/nginx/conf.d/default.conf

# Login sahifalari uchun IP bo'yicha so'rovlar chegarasi (parol tanlashga
# qarshi birinchi to'siq; Django'dagi hisob/IP cheklovi undan keyin ishlaydi).
limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;

# Noma'lum Host bilan kelgan so'rovlar (IP orqali skanerlash, begona domen)
# javobsiz yopiladi. 443'da sertifikat ham ko'rsatilmaydi.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    ssl_reject_handshake on;
    server_name _;
    return 444;
}

# HTTP: faqat Let's Encrypt tekshiruvi va HTTPS'ga yo'naltirish.
server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};
    # nginx versiyasini javob sarlavhalarida oshkor qilmaymiz.
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # Eng katta ruxsat etilgan yuklama (hujjatlar 50 MB) + multipart qo'shimchasi.
    # Django darajasidagi limitlar: apps/core/validators.py (MaxFileSizeValidator)
    client_max_body_size 52M;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    location /static/ {
        alias /app/staticfiles/;
    }

    # DIQQAT: /media/ ni bu yerdan tarqatmaymiz. Yuklangan fayllar (loyiha
    # hujjatlari, kelishuv javoblari, ilovalar) maxfiy — ular Django'dagi
    # protected_media view orqali, faqat ruxsati bor foydalanuvchiga
    # beriladi. Bu yerga `location /media/ { alias ...; }` qo'shilsa,
    # havolani bilgan har kim ularni autentifikatsiyasiz yuklab oladi.

    location ~ ^/accounts/(login|register)/ {
        limit_req zone=login burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://web:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://web:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
